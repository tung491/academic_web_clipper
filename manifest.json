{
  "manifest_version": 3,
  "name": "Academic Web Clipper",
  "version": "2.0.0",
  "description": "Clip academic papers to Obsidian-compatible markdown",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://ieeexplore.ieee.org/*",
    "*://arxiv.org/*",
    "*://link.springer.com/*",
    "*://media.springernature.com/*",
    "*://*.sciencedirect.com/*",
    "*://ars.els-cdn.com/*",
    "*://*.mdpi.com/*",
    "*://pub.mdpi-res.com/*",
    "*://onlinelibrary.wiley.com/*",
    "*://*.wiley.com/*",
    "*://*.tandfonline.com/*",
    "*://ascelibrary.org/*",
    "*://*.emerald.com/*",
    "*://emer.silverchair-cdn.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
